# WYNCORE server
# Preferred: transactional shared state for concurrent/serverless requests.
# Use a managed PostgreSQL database URL. Existing Blob/disk data is imported on first DB-backed request.
DATABASE_URL=
# Alternative for Vercel when a direct Postgres URL is unavailable: secure Supabase RPC over HTTPS.
# The RPC migration must be applied first; the RPC secret is private and must never be exposed to clients.
WYNCORE_SUPABASE_URL=
WYNCORE_SUPABASE_ANON_KEY=
WYNCORE_SUPABASE_RPC_SECRET=
# Optional: set to require only when your provider requires TLS and the certificate chain is trusted.
# DATABASE_SSL=require
DATABASE_POOL_MAX=5

WYNCORE_OWNER_PASSWORD=replace-with-a-long-random-password
WYNCORE_SESSION_SECRET=replace-with-at-least-32-random-characters

# Adscend Media: fill these only after Publisher approval and Rewarded Video activation.
ADSCEND_PUBLISHER_ID=
ADSCEND_API_KEY=
ADSCEND_POSTBACK_SECRET=replace-with-at-least-32-random-characters
ADSCEND_USER_SHARE=70
ADSCEND_DEFAULT_COUNTRY=BR

# Stripe: server-only keys. Payments stay blocked until the account is enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Enable only after Stripe approves WYNCORE as a Connect platform.
STRIPE_CONNECT_ENABLED=false

# Alternative to Postgres: enable only when DATA_DIR is an attached persistent disk on a single server instance.
# Never enable on Vercel/serverless or Vercel Blob.
# DATA_DIR=/var/data/wyncore
# WYNCORE_PAYOUT_STORAGE_MODE=single_writer

# Persistent Vercel Blob storage, if deployed on Vercel (financial transfers require transactional storage)
BLOB_READ_WRITE_TOKEN=

# Optional lead notifications through Resend (requires a verified sender domain)
RESEND_API_KEY=
WYNCORE_LEADS_FROM=
WYNCORE_LEADS_TO=

# Public HTTPS origin used for Stripe Checkout return URLs and webhooks
WYNCORE_PUBLIC_URL=https://seu-dominio-publico.com
