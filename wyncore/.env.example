# WYNCORE server
WYNCORE_OWNER_PASSWORD=replace-with-a-long-random-password
WYNCORE_SESSION_SECRET=replace-with-at-least-32-random-characters

# Asaas: start in Sandbox. Never commit real credentials.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=replace-with-at-least-32-random-random-characters
# Optional override. Sandbox default: https://api-sandbox.asaas.com/v3
# Production default when ASAAS_ENV=production: https://api.asaas.com/v3
# ASAAS_BASE_URL=

# Persistent Vercel Blob storage, if deployed on Vercel
BLOB_READ_WRITE_TOKEN=

# Optional lead notifications through Resend (requires a verified sender domain)
RESEND_API_KEY=
WYNCORE_LEADS_FROM=
WYNCORE_LEADS_TO=

# Public HTTPS origin used to register the Asaas webhook
WYNCORE_PUBLIC_URL=https://seu-dominio-publico.com
