# WYNCORE server (Node.js 22+)
PORT=3000
WYNCORE_PUBLIC_URL=https://wyncore.vercel.app
WYNCORE_OWNER_PASSWORD=
WYNCORE_SESSION_SECRET=

# Shared transactional storage (use the active WYNCORE Supabase project).
WYNCORE_SUPABASE_URL=
WYNCORE_SUPABASE_ANON_KEY=
WYNCORE_SUPABASE_RPC_SECRET=
# Optional direct PostgreSQL alternative.
DATABASE_URL=
DATABASE_POOL_MAX=5
# Optional Vercel Blob fallback.
BLOB_READ_WRITE_TOKEN=

# Stripe — server-only credentials; do not expose them to browser code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true only after Stripe has approved WYNCORE as a Connect platform.
STRIPE_CONNECT_ENABLED=false

# Optional rewarded-ad network, only after publisher approval.
ADSCEND_PUBLISHER_ID=
ADSCEND_API_KEY=
ADSCEND_POSTBACK_SECRET=
ADSCEND_USER_SHARE=70
ADSCEND_DEFAULT_COUNTRY=BR

# Optional lead notifications.
RESEND_API_KEY=
WYNCORE_LEADS_FROM=
WYNCORE_LEADS_TO=
